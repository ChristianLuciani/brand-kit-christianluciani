{
  "name": "brand-kit-christianluciani",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Brand kit canónico de Christian Luciani: logo triángulo-espiral, assets, generador y manual. Todos los derechos reservados.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianLuciani/brand-kit-christianluciani.git"
  },
  "scripts": {
    "test": "vitest run",
    "logo:generate": "node tools/logo/generate-logo.mjs",
    "logo:favicons": "node tools/logo/generate-logo.mjs --only-favicon",
    "logo:verify": "node tools/logo/verify-dom-fidelity.mjs",
    "badge:generate": "node tools/badge/generate-badge.mjs",
    "badge:check": "node tools/badge/generate-badge.mjs --check",
    "badge:preview": "node cdn/preview-server.mjs",
    "repo:check": "node tools/repo/check.mjs"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
